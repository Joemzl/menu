.page { display: flex; flex-direction: column; min-height: 100vh; }

.expired-bar { text-align: center; padding: 16rpx; background: #FFF3E0; color: #E65100; font-size: 26rpx; }

.main-body { display: flex; flex: 1; }

.dish-area { flex: 1; padding: 16rpx; overflow-y: auto; }

/* 购物车悬浮条 */
.cart-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 20rpx 32rpx; background: #FF6B35; color: #FFF; z-index: 50; box-sizing: border-box; }
.cart-info { display: flex; align-items: center; }
.cart-icon { font-size: 40rpx; }
.cart-count { font-size: 24rpx; margin-left: 8rpx; }
.cart-total { flex: 1; text-align: center; font-size: 36rpx; font-weight: 600; }
.cart-btn { font-size: 28rpx; font-weight: 500; }
