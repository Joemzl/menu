.page { display: flex; flex-direction: column; align-items: center; padding-top: 80rpx; min-height: 100vh; background: #FFF; }
.lock-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; }
.subtitle { font-size: 26rpx; color: #999; margin-bottom: 48rpx; }

.password-input { display: flex; gap: 24rpx; justify-content: center; margin-bottom: 16rpx; }
.password-dot { width: 88rpx; height: 88rpx; border: 2rpx solid #EEE; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; background: #FAFAFA; }
.password-dot.active { border-color: #FF6B35; background: #FFF3E0; }

.error-msg { font-size: 24rpx; color: #FA5151; margin-bottom: 16rpx; min-height: 36rpx; }

.keypad { display: flex; flex-wrap: wrap; width: 600rpx; margin-top: 48rpx; }
.keypad.disabled { opacity: 0.4; pointer-events: none; }
.key { width: 200rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; border: 1rpx solid #F0F0F0; box-sizing: border-box; background: #FFF; }
.key:active { background: #F5F5F5; }
.key-ok { background: #FF6B35; color: #FFF; font-size: 28rpx; }
.key-ok:active { background: #FF8C60; }
.key-del { color: #999; }
