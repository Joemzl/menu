<view class="page">
  <view class="lock-icon">🔒</view>
  <text class="title">请输入密码</text>
  <text class="subtitle">该菜单设置了密码保护</text>

  <!-- 密码圆点 -->
  <view class="password-input">
    <view class="password-dot {{password.length > 0 ? 'active' : ''}}">
      <text wx:if="{{password.length >= 1}}">●</text>
    </view>
    <view class="password-dot {{password.length > 1 ? 'active' : ''}}">
      <text wx:if="{{password.length >= 2}}">●</text>
    </view>
    <view class="password-dot {{password.length > 2 ? 'active' : ''}}">
      <text wx:if="{{password.length >= 3}}">●</text>
    </view>
    <view class="password-dot {{password.length > 3 ? 'active' : ''}}">
      <text wx:if="{{password.length >= 4}}">●</text>
    </view>
  </view>

  <text class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</text>

  <!-- 数字键盘 -->
  <view class="keypad {{locked ? 'disabled' : ''}}">
    <view wx:for="{{[1,2,3,4,5,6,7,8,9,'del',0,'ok']}}" wx:key="*this" class="key {{item === 'ok' ? 'key-ok' : item === 'del' ? 'key-del' : ''}}" data-key="{{item}}" bindtap="onKeyTap">
      <text wx:if="{{item === 'del'}}">⌫</text>
      <text wx:elif="{{item === 'ok'}}">确定</text>
      <text wx:else>{{item}}</text>
    </view>
  </view>
</view>
