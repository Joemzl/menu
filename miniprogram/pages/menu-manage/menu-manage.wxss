.page { padding-bottom: 120rpx; }

.header { padding: 32rpx 24rpx; background: linear-gradient(135deg, #FF6B35, #FF8C60); color: #FFF; }
.header-title { font-size: 36rpx; font-weight: 600; }
.header-meta { font-size: 24rpx; opacity: 0.8; margin-top: 8rpx; }

.dish-manage-card { margin: 16rpx 24rpx; }
.manage-dish-icon { width: 80rpx; height: 80rpx; border-radius: 12rpx; background: #F5F5F5; }
.dish-meta { display: flex; gap: 12rpx; margin-top: 6rpx; }
.meta-tag { font-size: 22rpx; padding: 2rpx 12rpx; background: #FFF3E0; color: #FF6B35; border-radius: 4rpx; }
.meta-price { font-size: 24rpx; color: #FF6B35; }
.action-btn { font-size: 24rpx; padding: 8rpx 16rpx; color: #1677FF; }
.action-btn.danger { color: #FA5151; }

.fab { position: fixed; right: 48rpx; bottom: 80rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: #FF6B35; color: #FFF; font-size: 56rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4); z-index: 50; }

.upload-area { width: 160rpx; height: 160rpx; border: 2rpx dashed #CCC; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; }
.upload-preview { width: 100%; height: 100%; border-radius: 12rpx; }
.upload-hint { font-size: 24rpx; color: #CCC; }

.picker { min-width: 160rpx; height: 80rpx; line-height: 80rpx; text-align: center; border: 2rpx solid #EEE; border-radius: 8rpx; font-size: 28rpx; color: #666; }

.modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; }
.modal-mask { position: absolute; inset: 0; background: rgba(0,0,0,0.4); }
.modal-content { position: relative; width: 600rpx; background: #FFF; border-radius: 16rpx; padding: 40rpx; max-height: 80vh; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 32rpx; display: block; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-btns button { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 8rpx; font-size: 28rpx; }
.btn-outline { background: #FFF; border: 2rpx solid #FF6B35 !important; color: #FF6B35 !important; }
.btn-primary { background: #FF6B35 !important; color: #FFF !important; border: none; }

.input { width: 100%; height: 80rpx; border: 2rpx solid #EEE; border-radius: 8rpx; padding: 0 20rpx; margin-bottom: 20rpx; font-size: 28rpx; box-sizing: border-box; }

.ml-16 { margin-left: 16rpx; }
.flex { display: flex; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-1 { flex: 1; }

.dish-name { font-size: 28rpx; font-weight: 500; }
