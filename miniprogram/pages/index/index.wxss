.page { min-height: 100vh; padding-bottom: 48rpx; }

.role-section { padding: 80rpx 48rpx; text-align: center; }
.role-header { font-size: 36rpx; font-weight: 600; margin-bottom: 48rpx; }
.role-options { display: flex; gap: 24rpx; }
.role-card { flex: 1; padding: 48rpx 24rpx; background: #FFF; border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.role-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.role-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.role-desc { font-size: 24rpx; color: #999; display: block; }

.menu-section { padding: 24rpx; }
.header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; }
.btn-create { background: #FF6B35; color: #FFF; font-size: 28rpx; padding: 12rpx 32rpx; border-radius: 8rpx; border: none; }
.btn-small { font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 6rpx; background: #FFF3E0; color: #FF6B35; border: none; }

.menu-card { margin: 0 0 16rpx; }
.menu-title { font-size: 30rpx; font-weight: 500; }
.menu-meta { margin-top: 8rpx; }
.meta-item { font-size: 22rpx; color: #999; margin-right: 16rpx; }
.menu-actions { display: flex; gap: 12rpx; }

.modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; }
.modal-mask { position: absolute; inset: 0; background: rgba(0,0,0,0.4); }
.modal-content { position: relative; width: 600rpx; background: #FFF; border-radius: 16rpx; padding: 40rpx; }
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 32rpx; display: block; }
.input { width: 100%; height: 80rpx; border: 2rpx solid #EEE; border-radius: 8rpx; padding: 0 20rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.toggle-row { display: flex; justify-content: space-between; align-items: center; padding: 0 8rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-btns button { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 8rpx; font-size: 28rpx; }
.btn-outline { background: #FFF; border: 2rpx solid #FF6B35 !important; color: #FF6B35 !important; }
.btn-primary { background: #FF6B35 !important; color: #FFF !important; border: none; }
