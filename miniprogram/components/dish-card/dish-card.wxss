.dish-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.dish-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
}

.dish-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.dish-price {
  font-size: 24rpx;
  color: #FF6B35;
  margin-top: 8rpx;
}

.dish-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid #FF6B35;
  font-size: 32rpx;
  color: #FF6B35;
  background: transparent;
}

.stepper-btn.disabled {
  border-color: #CCCCCC;
  color: #CCCCCC;
}

.stepper-count {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 10rpx;
}
